# Railway will supply PORT in production. Leave this unset for the local default.
# PORT=3000

# Added only when PostgreSQL persistence is implemented in Milestone 8.
# DATABASE_URL=

# Required only to make WebMCP available to ordinary visitors on the deployed
# Chrome origin while the API is in its Chrome origin trial. Do not commit it.
# WEBMCP_ORIGIN_TRIAL_TOKEN=

# Optional. Set this when building the frontend for ChatGPT Sites or another
# static host so browser-side API calls continue to use the live Railway
# backend for persistence, repository import, telemetry, demand, and status
# evidence.
# VITE_AETHER_API_BASE_URL=https://webmcp-production-38e5.up.railway.app
